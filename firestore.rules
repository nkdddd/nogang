rules_version = '2';
// 우리집 학습플래너 (플래너 · 천문장 · MD영단어 · 그래머 인사이드) — Firebase 프로젝트 splan-5512
// Firebase 콘솔 → Firestore Database → 규칙 탭에 통째로 붙여넣고 '게시'하세요.
// (바꾸기 전에 지금 규칙을 복사해 백업해 두세요.)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    // 가족 연결된 부모인가: links/{부모uid}/children/{자녀uid} 가 있으면 부모
    function isParentOf(uid) {
      return signedIn() && exists(/databases/$(database)/documents/links/$(request.auth.uid)/children/$(uid));
    }
    function myEmail() { return request.auth.token.email.lower(); }

    // 프로필 {name, role, email} — 본인, 연결된 부모만
    match /users/{uid} {
      allow read: if isMe(uid) || isParentOf(uid);
      allow write: if isMe(uid);
    }

    // 플래너 · 학습앱 기록 전체 (tasks, meta, diary, apps/*, focus, payouts, 💬 chat …)
    // 부모는 연결된 자녀의 기록을 보고, 코멘트 · 용돈 지급 · 카드 지급 등을 기록합니다.
    match /planner/{uid}/{document=**} {
      allow read, write: if isMe(uid) || isParentOf(uid);
    }

    // 가족 연결 신청 (이메일로 신청 → 받은 사람이 승인)
    match /familyRequests/{id} {
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.status == "pending";
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toEmail == myEmail());
      // 보낸 사람은 취소·해제, 받은 사람은 승인·거절 (받은 사람은 toUid에 자기 uid만 넣을 수 있음)
      allow update: if signedIn()
                    && (resource.data.fromUid == request.auth.uid
                        || (resource.data.toEmail == myEmail() && request.resource.data.toUid == request.auth.uid))
                    && request.resource.data.fromUid == resource.data.fromUid
                    && request.resource.data.toEmail == resource.data.toEmail;
      allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
    }

    // 부모-자녀 연결: 부모 본인만, 새로 만들 때는 승인된 신청이 있어야 함
    function acceptedLink(parent, child, rid) {
      let r = get(/databases/$(database)/documents/familyRequests/$(rid)).data;
      return r.status == "accepted"
        && ((r.fromUid == parent && r.toUid == child) || (r.fromUid == child && r.toUid == parent));
    }
    match /links/{parent}/children/{child} {
      allow read, delete: if isMe(parent);
      allow create, update: if isMe(parent) && request.resource.data.requestId is string
                            && acceptedLink(parent, child, request.resource.data.requestId);
    }

    // 💰 용돈 기준 (1시간당 금액 · 주간/하루 최대 · 학습앱 포함): 자녀는 보기만, 연결된 부모만 바꿀 수 있음
    match /payTerms/{child} {
      allow read: if isMe(child) || isParentOf(child);
      allow write: if isParentOf(child);
    }

    // 🎴 가족 카드: cardHub/{부모uid} — 부모 본인 + 그 부모와 연결된 자녀
    function isFamilyOf(p) {
      return isMe(p) || (signedIn() && exists(/databases/$(database)/documents/links/$(p)/children/$(request.auth.uid)));
    }
    match /cardHub/{p}/pool/{id} {          // (예전) 카드 링크 카드풀 — 지금은 쓰지 않음
      allow read: if isFamilyOf(p);
      allow write: if isMe(p);
    }
    match /cardHub/{p}/decks/{child} {      // 대결용 덱: 자녀 본인이 공개 · 가족은 보기
      allow read: if isFamilyOf(p);
      allow write: if isMe(p) || (isMe(child) && isFamilyOf(p));
    }
    match /cardHub/{p}/matches/{id} {       // ⚔️ 형제 대결 (신청 → 카드 → 주사위). 대결하는 두 사람만
      allow read, update, delete: if isFamilyOf(p) && request.auth.uid in resource.data.users;
      allow create: if isFamilyOf(p) && request.auth.uid in request.resource.data.users;
    }
    match /cardHub/{p}/battles/{id} {       // 대결 기록
      allow read, create: if isFamilyOf(p);
      allow delete: if isMe(p);
    }

    // 예전 6자리 코드 (더 이상 만들지 않음) — 탈퇴할 때 본인 코드 삭제만
    match /codes/{code} {
      allow read: if signedIn();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ===== 🤝 친구 응원 (스티커만 · 양쪽 부모 승인) =====
    function pairOf(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function friendsOk(a, b) {
      let f = get(/databases/$(database)/documents/friends/$(pairOf(a, b))).data;
      return f.status == 'accepted' && f.okFrom == true && f.okTo == true;
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function newFriendReq(fid) {
      let d = request.resource.data;
      return d.from == request.auth.uid && d.to is string && d.from != d.to
        && fid == pairOf(d.from, d.to) && d.users == [d.from, d.to]
        && d.status == 'pending' && d.okFrom == false && d.okTo == false
        && d.parents is list && d.parents.size() <= 6 && d.names is map
        && d.keys().hasOnly(['users', 'from', 'to', 'names', 'parents', 'status', 'okFrom', 'okTo', 'at']);
    }

    // 친구 코드: 정확한 코드로만 찾기 (목록 보기 불가)
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'nick', 'at'])
                    && request.resource.data.nick is string && request.resource.data.nick.size() <= 12;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // 친구 관계: 두 아이 + 그 부모님만 봐요
    match /friends/{fid} {
      allow read: if signedIn() && (request.auth.uid in resource.data.users || request.auth.uid in resource.data.parents);
      allow create: if signedIn() && newFriendReq(fid);
      allow update: if signedIn() && (
        // 끝난 사이에 다시 신청
        (resource.data.status == 'ended' && request.auth.uid in resource.data.users && newFriendReq(fid))
        // 받은 아이가 수락 (자기 부모님을 더해요)
        || (request.auth.uid == resource.data.to && resource.data.status == 'pending'
            && request.resource.data.status == 'accepted' && changed().hasOnly(['status', 'parents', 'acceptedAt']))
        // 아이가 새로 연결된 부모님을 더함
        || (request.auth.uid in resource.data.users && changed().hasOnly(['parents']) && request.resource.data.parents.size() <= 6)
        // 각자 부모님 승인
        || (isParentOf(resource.data.from) && changed().hasOnly(['okFrom']) && request.resource.data.okFrom == true)
        || (isParentOf(resource.data.to) && changed().hasOnly(['okTo']) && request.resource.data.okTo == true)
        // 끊기 · 거절 (아이나 부모님 누구나)
        || ((request.auth.uid in resource.data.users || isParentOf(resource.data.from) || isParentOf(resource.data.to))
            && request.resource.data.status == 'ended' && changed().hasOnly(['status', 'endedBy', 'endedAt']))
      );
    }

    // 친구에게 보이는 작은 카드 (별명 · 캐릭터 · 공부한 날 수 · 습관 일수)
    match /friendCards/{uid} {
      allow read: if isMe(uid) || isParentOf(uid) || (signedIn() && friendsOk(request.auth.uid, uid));
      allow write: if isMe(uid) && request.resource.data.keys().hasOnly(['nick', 'el', 'stage', 'wkDays', 'habitN', 'at'])
                   && request.resource.data.nick is string && request.resource.data.nick.size() <= 12;
    }

    // 응원 스티커: 친구만, 정해진 스티커만, 스티커마다 하루 한 번 (문서 id = 보낸uid_날짜_스티커)
    match /planner/{uid}/cheers/{cid} {
      allow create: if signedIn() && request.auth.uid != uid && friendsOk(request.auth.uid, uid)
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.keys().hasOnly(['from', 'sticker', 'day', 'at'])
                    && request.resource.data.sticker in ['clap', 'fire', 'strong', 'star', 'together', 'party', 'book', 'smile']
                    && request.resource.data.day is string && request.resource.data.day.size() == 10
                    && cid == request.auth.uid + '_' + request.resource.data.day + '_' + request.resource.data.sticker;
    }

    // MD영단어 예문 캐시 (모든 사용자 공용)
    match /sentences/{id} {
      allow read, write: if signedIn();
    }

    // 그래머 인사이드 친구 랭킹
    match /giUsers/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid);
    }
    match /giFriendRequests/{id} {
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if signedIn() && resource.data.toUid == request.auth.uid;
    }
  }
}
